default_platform(:ios)

platform :ios do
  desc "BETA: Build and upload to TestFlight for internal testing"
  lane :beta do
    # Setup API
    api = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    # Use the generated project
    project_path = "ios/Fotbollsresan.xcodeproj"
    scheme_name = "Fotbollsresan"

    # Increment build number
    increment_build_number(xcodeproj: project_path)
    
    # Enable automatic code signing for all configurations
    update_code_signing_settings(
      use_automatic_signing: true,
      path: project_path,
      team_id: "MW98Z2Q68W",
      bundle_identifier: "com.ajagames.learnfotball",
      code_sign_identity: "Apple Distribution",
      profile_name: ""
    )
    
    # Build with more explicit settings
    gym(
      project: project_path,
      scheme: scheme_name,
      export_method: "app-store",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates -allowProvisioningDeviceRegistration",
      export_options: {
        method: "app-store",
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      }
    )
    
    # Upload to TestFlight
    pilot(
      api_key: api,
      skip_waiting_for_build_processing: true,
      beta_app_description: "Fotbollsresan - AI-driven fotbollsträning för barn. Testa alla huvudfunktioner: interaktiva scenarier, XP-system, badges och dagliga utmaningar.",
      beta_app_feedback_email: "feedback@fotbollsresan.se",
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "RELEASE: Build and prepare for App Store release"
  lane :release do
    # Setup API
    api = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    # Increment version number
    increment_version_number(xcodeproj: "ios/Fotbollsresan.xcodeproj")
    
    # Enable automatic code signing
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/Fotbollsresan.xcodeproj",
      team_id: "MW98Z2Q68W"
    )
    
    # Build for release
    gym(
      project: "ios/Fotbollsresan.xcodeproj",
      scheme: "Fotbollsresan", 
      export_method: "app-store",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates -allowProvisioningDeviceRegistration"
    )
    
    # Upload to App Store Connect (ready for manual release)
    deliver(
      api_key: api,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false
    )
  end

  desc "SIM: build iOS Simulator .app and zip as artifact"
  lane :sim do
    require 'json'
    project = Dir["ios/*.xcodeproj"].first
    UI.user_error!("No Xcode project found in ios directory") if project.nil?

    scheme = "Fotbollsresan"

    sh("rm -rf build")
    sh("xcodebuild -project \"#{project}\" -scheme \"#{scheme}\" -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build clean build | xcpretty")

    app_path = Dir["build/Build/Products/**/Debug-iphonesimulator/*.app"].first
    UI.user_error!("Simulator .app not found in derived data") if app_path.nil?

    zip_target = File.expand_path("simulator_app.zip")
    Dir.chdir(File.dirname(app_path)) { sh("zip -r \"#{zip_target}\" \"#{File.basename(app_path)}\"") }
    UI.success("Simulator artifact: #{zip_target}")
  end
end