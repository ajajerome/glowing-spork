default_platform(:ios)

platform :ios do
  desc "BETA: Build and upload to TestFlight for internal testing"
  lane :beta do
    # Ensure we're using the right Xcode (try different paths)
    begin
      sh("sudo xcode-select -s /Applications/Xcode.app")
    rescue
      begin
        sh("sudo xcode-select -s /Applications/Xcode_15.app")
      rescue
        # Use whatever Xcode is available
        sh("xcode-select -p")
      end
    end
    
    # Setup API
    api = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    # Use local paths since we're running from ios/ directory
    project_path = "TaktikTräning.xcodeproj"
    scheme_name = "TaktikTräning"

    UI.message("🧪 Testing compilation for simulator first...")
    UI.message("📁 Current directory: #{Dir.pwd}")
    UI.message("🔍 Looking for project at: #{project_path}")
    
    # List current directory contents
    UI.message("📂 Current directory contents:")
    sh("ls -la")
    
    # Check if project exists
    if File.exist?(project_path)
      UI.success("✅ Project found at #{project_path}")
    else
      UI.error("❌ Project NOT found at #{project_path}")
      UI.user_error!("Project file does not exist!")
    end
    
    sh("xcodebuild -project '#{project_path}' -scheme '#{scheme_name}' -configuration Debug -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 15' clean build")

    # If simulator build works, proceed with archive
    UI.message("✅ Simulator build successful, proceeding with archive...")

    # Increment build number
    increment_build_number(xcodeproj: project_path)
    
    # Enable automatic code signing for all configurations
    update_code_signing_settings(
      use_automatic_signing: true,
      path: project_path,
      team_id: "MW98Z2Q68W",
      bundle_identifier: "com.ajagames.fotbollsresan"
    )
    
    # Create build directory
    sh("mkdir -p build")
    
    # Build with gym (simpler than direct xcodebuild)
    gym(
      project: project_path,
      scheme: scheme_name,
      export_method: "app-store",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates -allowProvisioningDeviceRegistration"
    )
    
    # Upload to TestFlight
    pilot(
      api_key: api,
      skip_waiting_for_build_processing: true,
      beta_app_description: "TaktikTräning - AI-driven fotbollsträning för barn. Testa alla huvudfunktioner: interaktiva scenarier, XP-system, badges och dagliga utmaningar.",
      beta_app_feedback_email: "feedback@fotbollsresan.se",
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "SIM: build iOS Simulator .app and zip as artifact"
  lane :sim do
    project = Dir["ios/*.xcodeproj"].first
    UI.user_error!("No Xcode project found in ios directory") if project.nil?

    scheme = "TaktikTräning"

    sh("rm -rf build")
    sh("xcodebuild -project '#{project}' -scheme '#{scheme}' -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build clean build")

    app_path = Dir["build/Build/Products/**/Debug-iphonesimulator/*.app"].first
    UI.user_error!("Simulator .app not found in derived data") if app_path.nil?

    zip_target = File.expand_path("simulator_app.zip")
    Dir.chdir(File.dirname(app_path)) { sh("zip -r \"#{zip_target}\" \"#{File.basename(app_path)}\"") }
    UI.success("Simulator artifact: #{zip_target}")
  end
end