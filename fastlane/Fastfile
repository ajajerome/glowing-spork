default_platform(:ios)

platform :ios do
  desc "BETA: Build and upload to TestFlight for internal testing"
  lane :beta do
    # Ensure we're using the right Xcode (try different paths)
    begin
      sh("sudo xcode-select -s /Applications/Xcode.app")
    rescue
      begin
        sh("sudo xcode-select -s /Applications/Xcode_15.app")
      rescue
        # Use whatever Xcode is available
        sh("xcode-select -p")
      end
    end
    
    # Setup API
    api = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    # Use correct paths from fastlane directory
    ios_dir = "../ios"  # Go up one level from fastlane/ to reach ios/
    
    UI.message("🔍 Debugging Dir.glob...")
    UI.message("📁 Current working directory: #{Dir.pwd}")
    UI.message("📂 Looking in: #{ios_dir}/")
    UI.message("🎯 Glob pattern: #{ios_dir}/*.xcodeproj")
    
    project_files = Dir.glob("#{ios_dir}/*.xcodeproj")
    UI.message("📋 Dir.glob result: #{project_files.inspect}")
    UI.message("📊 Found #{project_files.length} project files")
    
    if project_files.empty?
      UI.error("❌ Dir.glob returned empty array!")
      UI.message("🔍 Let's try different approaches:")
      UI.message("📂 Dir.entries('#{ios_dir}'):")
      begin
        Dir.entries(ios_dir).each { |entry| UI.message("  - #{entry}") }
      rescue => e
        UI.error("Error reading directory: #{e.message}")
      end
      UI.message("🔍 Manual check with File.exist?:")
      UI.message("  - #{ios_dir}/TaktikTräning.xcodeproj exists? #{File.exist?('#{ios_dir}/TaktikTräning.xcodeproj')}")
      UI.user_error!("❌ No .xcodeproj files found in #{ios_dir}/ directory!")
    end
    
    project_path = project_files.first
    scheme_name = File.basename(project_path, ".xcodeproj")
    
    UI.message("🔍 Found project: #{project_path}")
    UI.message("🎯 Using scheme: #{scheme_name}")

    UI.message("🧪 Building TaktikTräning for TestFlight...")
    UI.message("📁 Current directory: #{Dir.pwd}")
    UI.message("🔍 Project: #{project_path}")
    UI.message("📱 Bundle ID: com.ajagames.taktiktraning")
    UI.message("👥 Team ID: MW98Z2Q68W")
    
    # List current directory contents
    UI.message("📂 Current directory contents:")
    sh("ls -la")
    
    # Check for any .xcodeproj files
    UI.message("🔍 Looking for any .xcodeproj files:")
    sh("find . -name '*.xcodeproj' -type d")
    
    # Check if our specific project exists
    UI.message("🎯 Checking for specific project: #{project_path}")
    if File.exist?(project_path)
      UI.success("✅ Project found at #{project_path}")
    else
      UI.error("❌ Project file #{project_path} does not exist!")
      UI.message("📁 Current working directory: #{Dir.pwd}")
      UI.message("📂 Directory contents:")
      Dir.entries(".").each { |entry| UI.message("  - #{entry}") }
      UI.user_error!("Project file not found - check debug output above")
    end

    # Create API key file for xcodebuild authentication
    api_key_path = "#{ENV['HOME']}/AuthKey_#{ENV['ASC_KEY_ID']}.p8"
    File.write(api_key_path, ENV['ASC_API_KEY_P8'])
    File.chmod(0600, api_key_path)
    UI.message("🔑 Created API key at: #{api_key_path}")

    # Increment build number with absolute path
    absolute_project_path = File.expand_path(project_path)
    UI.message("🔢 Incrementing build number for: #{absolute_project_path}")
    increment_build_number(xcodeproj: absolute_project_path)
    
    # Build with gym - let automatic signing handle everything
    UI.message("🏗️ Building with gym using absolute path: #{absolute_project_path}")
    gym(
      project: absolute_project_path,
      scheme: scheme_name,
      export_method: "app-store",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates -allowProvisioningDeviceRegistration -authenticationKeyPath #{api_key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      export_options: {
        method: "app-store",
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false,
        teamID: "MW98Z2Q68W",
        signingStyle: "automatic"
      }
    )
    
    # Upload to TestFlight
    pilot(
      api_key: api,
      skip_waiting_for_build_processing: true,
      beta_app_description: "TaktikTräning - AI-driven fotbollsträning för barn. Testa alla huvudfunktioner: interaktiva scenarier, XP-system, badges och dagliga utmaningar.",
      beta_app_feedback_email: "feedback@fotbollsresan.se",
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "SIM: build iOS Simulator .app and zip as artifact"
  lane :sim do
    project = Dir["ios/*.xcodeproj"].first
    UI.user_error!("No Xcode project found in ios directory") if project.nil?

    scheme = "TaktikTräning"

    sh("rm -rf build")
    sh("xcodebuild -project '#{project}' -scheme '#{scheme}' -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build clean build")

    app_path = Dir["build/Build/Products/**/Debug-iphonesimulator/*.app"].first
    UI.user_error!("Simulator .app not found in derived data") if app_path.nil?

    zip_target = File.expand_path("simulator_app.zip")
    Dir.chdir(File.dirname(app_path)) { sh("zip -r \"#{zip_target}\" \"#{File.basename(app_path)}\"") }
    UI.success("Simulator artifact: #{zip_target}")
  end
end